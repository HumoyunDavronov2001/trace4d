# YEROSTI data markaz sozlamalari:  cp .env.example .env  va qiymatlarni to'ldiring. .env git/zaxiraga tushmasin.

# Sayt domeni (TLS sertifikati shu nomga)
YEROSTI_DOMEN=trace4d.example.uz

# Tashqi manzil: ijro hujjatidagi QR (/t/...) va ulashish havolalari (/u/...) shu bilan boshlanadi.
# Bo'sh qolsa so'rovning Host sarlavhasidan olinadi — ishlab chiqarishda albatta to'ldiring (https://<domen>)
YEROSTI_TASHQI_URL=https://trace4d.example.uz

# Birinchi admin paroli. Bo'sh qolsa — server jurnalida BIR MARTA chiqadi: docker compose logs server
YEROSTI_ADMIN_PAROL=

# Portal xaritasi asosi: "yoq" — asos xaritasiz, to'liq oflayn (hokimlik data markazi uchun standart);
# mahalliy plitka serveri uslubi (masalan https://xarita.ichki.uz/styles/positron) yoki tashqi OpenFreeMap:
# https://tiles.openfreemap.org/styles/positron  (CSP shu manzilning o'zigagina ochiladi)
YEROSTI_XARITA_USLUB=yoq

# Xarita asoslari (TALABLAR 16). Surat o'lchov aniqligini oshirmaydi: faqat kontekst va metrlab xatoni ko'zda ushlash.
# Shahar ortofotosi: QGIS "Generate XYZ tiles (MBTiles)" bilan yasalgan fayl `malumot` hajmida (masalan
# /malumot/ortofoto.mbtiles); faqat portalga kirganlarga beriladi. Aniqlik — ortofoto pasportidagi qiymat, metr.
YEROSTI_ORTOFOTO=
YEROSTI_ORTOFOTO_ANIQLIK_M=
# Tashqi sun'iy yo'ldosh (ixtiyoriy, litsenziya bilan): XYZ shablon https://…/{z}/{x}/{y}; atributsiyasiz yoqilmaydi.
# Esri World Imagery tijoriy ilovada ArcGIS hisobi va kalit talab qiladi; aniqligi 4–10 m (CE90).
YEROSTI_SUNIY_URL=
YEROSTI_SUNIY_ATRIBUTSIYA=
YEROSTI_SUNIY_ANIQLIK_M=
YEROSTI_SUNIY_MAKS_ZOOM=19

# Mustaqil qayta hisob (DM-02): bitta skan uchun vaqt chegarasi, soniya
YEROSTI_TAHLIL_VAQT_S=900

# Zaxira (DM-05): hostdagi papka, har necha soatda, nechta zaxira saqlanadi
YEROSTI_ZAXIRA_PAPKA=./zaxira
YEROSTI_ZAXIRA_SOAT=24
YEROSTI_ZAXIRA_SAQLASH=14
